# ==============================================================================
# CONFIGURAÇÃO DE AMBIENTE - ECOSSISTEMA RH AUDIT & DATA ENGINEERING
# ==============================================================================
# Copie este arquivo para .env e preencha com as suas credenciais locais.
# NUNCA versione o arquivo .env no Git.

# ------------------------------------------------------------------------------
# 1. Compliance Cadastral & Robô de Afastados (Módulo 10)
# ------------------------------------------------------------------------------
# Token de autenticação da API SintegraWS (consultas de CNPJ, QSA, Situação Cadastral)
SINTEGRAWS_TOKEN=seu_token_sintegravws_aqui

# Token alternativo para InfoSimples / APIs de apoio
INFOSIMPLES_TOKEN=seu_token_infosimples_aqui

# ------------------------------------------------------------------------------
# 2. Conectividade Social / FGTS (Módulo 04)
# ------------------------------------------------------------------------------
# Configurações do Certificado Digital A1 (geralmente instalado no Windows Cert Store)
# Caso utilize arquivo PFX local (NUNCA versione o arquivo .pfx):
CERT_A1_PATH=C:\caminho\seguro\certificado.pfx
CERT_A1_PASSWORD=senha_do_certificado_aqui

# ------------------------------------------------------------------------------
# 3. Integração com Banco de Dados / APIs de Folha (LG Lugar de Gente / Oracle)
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=1521
DB_SERVICE_NAME=ORCL
DB_USER=usuario_leitura
DB_PASSWORD=senha_acesso

# ------------------------------------------------------------------------------
# 4. Parâmetros Globais e Logs
# ------------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
